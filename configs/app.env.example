APP_ENV=local

GATEWAY_ADDR=:8080
LINKSVC_ADDR=:8081
REDIRECTSVC_ADDR=:8082
STATSVC_ADDR=:8083
WORKER_ADDR=:8084
LINKSVC_NODE_ID=1
STATSVC_NODE_ID=2
ETCD_ENDPOINTS=127.0.0.1:2379
ETCD_DIAL_TIMEOUT=3s
ETCD_LEASE_TTL=10
LINKSVC_ADVERTISE_ADDR=127.0.0.1:8081
REDIRECTSVC_ADVERTISE_ADDR=127.0.0.1:8082
STATSVC_ADVERTISE_ADDR=127.0.0.1:8083

MYSQL_DSN=flashlink:flashlink@tcp(127.0.0.1:3306)/flashlink?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379
REDIS_DB=0
REDIS_POOL_SIZE=20
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=1s
REDIS_WRITE_TIMEOUT=1s
BLOOM_FILTER_KEY=flashlink:filter:codes
BLOOM_FILTER_CAPACITY=10000000
BLOOM_FILTER_ERROR_RATE=0.01
SHORT_LINK_DOMAIN=http://127.0.0.1:8080

CLEANUP_ENABLED=true
CLEANUP_INTERVAL=24h
CLEANUP_VISIT_RETENTION=720h
CLEANUP_STAT_RETENTION=4320h
CLEANUP_BATCH_SIZE=1000
